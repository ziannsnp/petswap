# Settings for docker-compose.yml. Do not copy this file by hand:
#
#   sh scripts/stack-env.sh
#
# writes .env from it with freshly generated secrets. Every key here is required
# by the stack; scripts/stack-health.sh fails if .env is missing one.
# Plain KEY=VALUE only: no quotes, no spaces around "=", no inline comments.
# For the Vite dev server env files see .env.local.example and web/.env.example.

# --- Secrets (generated by scripts/stack-env.sh; never commit real values) ---

# Password for every Postgres role the services connect as. URL-safe characters
# only: it is embedded in connection strings.
POSTGRES_PASSWORD=
# HMAC secret that signs every JWT in the stack. At least 32 characters.
JWT_SECRET=
# JWTs signed with JWT_SECRET, carrying role=anon and role=service_role. ANON_KEY
# is baked into the web bundle at build time; SERVICE_ROLE_KEY stays server-side.
ANON_KEY=
SERVICE_ROLE_KEY=

# --- Addresses ---

# Interface the published ports bind to. 127.0.0.1 keeps the stack private to
# this machine; 0.0.0.0 exposes it to the network.
BIND_ADDRESS=127.0.0.1
# Host ports for the web app, the Supabase API gateway, and Postgres. They match
# `supabase start`, so stop that stack first (`npx supabase stop`).
WEB_PORT=5173
API_PORT=54321
DB_PORT=54322
# Where a browser reaches the web app and the API gateway. Change both together
# with the ports or host above. API_EXTERNAL_URL is baked into the web bundle.
SITE_URL=http://127.0.0.1:5173
API_EXTERNAL_URL=http://127.0.0.1:54321
# Extra comma-separated URLs Auth may redirect to. May be empty.
ADDITIONAL_REDIRECT_URLS=http://localhost:5173

# --- sign-in Edge Function (see docs/environments.md) ---

# Comma-separated exact browser origins, no trailing slash. Must include the
# origin of SITE_URL or username sign-in is rejected with a 403.
SIGN_IN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# HTTPS preview hostname suffix to accept. Empty disables preview origins.
SIGN_IN_PREVIEW_HOSTNAME_SUFFIX=

# --- Data ---

# true loads supabase/seed.sql into a new database: three test accounts with a
# published password. Set false on anything reachable from outside this machine.
SEED_DEMO_DATA=true
